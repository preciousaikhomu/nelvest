# ---- Database (Postgres; Neon from the Vercel Marketplace works) ----
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# ---- Sessions & secrets (generate each with: npm run keygen) ----
SESSION_SECRET=""
KEY_ENCRYPTION_KEY=""          # 32-byte base64; encrypts exchange API keys and TOTP secrets
CRON_SECRET=""                 # protects /api/engine/tick

# ---- Owner admin (used by: npm run admin:create) ----
OWNER_EMAIL="you@example.com"
SETUP_TOKEN=""                 # one-time token for /admin/setup (npm run keygen)

# ---- Safety switches ----
DEPOSITS_ENABLED="false"       # keep false until SEC registration is granted
TRADING_MODE="paper"           # paper | testnet | live
LIVE_TRADING_ACK=""            # must equal "I-HAVE-SEC-APPROVAL" for live mode to start

# ---- KYC ----
KYC_PROVIDER="mock"            # mock | dojah | smileid
DOJAH_APP_ID=""
DOJAH_SECRET_KEY=""
DOJAH_BASE_URL="https://sandbox.dojah.io"
SMILE_PARTNER_ID=""
SMILE_API_KEY=""
SMILE_BASE_URL="https://testapi.smileidentity.com/v1"

# ---- Market data exchange for signals ----
SIGNAL_EXCHANGE="binance"

# ---- Managed (pooled) account exchange keys, live/testnet only ----
MANAGED_EXCHANGE="binance"
MANAGED_API_KEY=""
MANAGED_API_SECRET=""
